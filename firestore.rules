rules_version = '2';

// Sicherheitsregeln für das Weihnachtsbingo.
// In der Firebase-Konsole unter Firestore Database > Regeln einfügen und "Veröffentlichen".
//
// Jeder Spieler hat ein Konto (Benutzername + Passwort). Jeder kann Spiele erstellen;
// wer ein Spiel erstellt, ist dort die Spielleitung (owner).
//
// Aufbau:
//   users/{uid}                  { name, games, email?, loginKey? }     eigenes Konto, Liste der eigenen Spiele
//   names/{nameKey}              { uid }                                Benutzername vergeben (bei hinterlegter E-Mail)
//   logins/{loginKey}            { email, uid }                         freiwillige E-Mail fürs Anmelden mit Benutzername;
//                                                                         ID = Schlüssel aus Name + Passwort
//   games/{g}                    { name, owner, ownerName, locked, songsEnabled, songsSeeded, createdAt }
//   games/{g}/private/invite     { code, open }                         geheimer Einladungscode (nur Spielleitung)
//   games/{g}/members/{uid}      { invite, joinedAt }                   Nachweis, dass man eingeladen wurde
//   games/{g}/boards/{uid}       { name, cells, canAddWords }           öffentliches Bingo-Feld, ID = Konto
//   games/{g}/days/{1..24}       { words, updatedBy, updatedAt }        Wörter des Adventskalenders
//   games/{g}/songs/{songId}     { title, addedBy, addedByUid }         Liederpool (ID = Titel als Kürzel)
//   games/{g}/songDays/{1..24}   { picked, random, updatedAt }          Lieder eines Abends:
//                                  picked = von Spielern ausgesucht [{ title, by, uid }], random = [title]
//
// Wer die Spiel-ID kennt (steht im Einladungslink), darf das Spiel ansehen, auch ohne Konto.
// Mitspielen kann nur, wer den gültigen Einladungscode hat.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function gamePath(g) {
      return /databases/$(database)/documents/games/$(g);
    }

    function boardPath(g, uid) {
      return /databases/$(database)/documents/games/$(g)/boards/$(uid);
    }

    // Spielleitung (Stand vor dem Schreiben)
    function isOwner(g) {
      return signedIn() && exists(gamePath(g)) && get(gamePath(g)).data.owner == request.auth.uid;
    }

    // Spielleitung, auch wenn das Spiel im selben Batch gerade erst angelegt wird
    function isOwnerAfter(g) {
      return signedIn() && existsAfter(gamePath(g)) && getAfter(gamePath(g)).data.owner == request.auth.uid;
    }

    // Spielt mit (hat ein Feld in diesem Spiel)
    function isPlayer(g) {
      return signedIn() && exists(boardPath(g, request.auth.uid));
    }

    function myBoard(g) {
      return get(boardPath(g, request.auth.uid)).data;
    }

    // Lieder bei diesem Spiel eingeschaltet (ältere Spiele ohne Angabe: ja)
    function songsOn(g) {
      return get(gamePath(g)).data.get('songsEnabled', true) == true;
    }

    function fieldsLocked(g) {
      return get(gamePath(g)).data.get('locked', false) == true;
    }

    function validInvite(g, code) {
      let inv = get(/databases/$(database)/documents/games/$(g)/private/invite).data;
      return code is string && inv.get('open', false) == true && inv.code == code;
    }

    function validGameName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    function validDay(day) {
      return day.matches('^([1-9]|1[0-9]|2[0-4])$');
    }

    // Alle Einträge (höchstens 3) gehören dem angemeldeten Spieler
    function allMine(list) {
      return list.size() <= 3
        && (list.size() < 1 || list[0].get('uid', '') == request.auth.uid)
        && (list.size() < 2 || list[1].get('uid', '') == request.auth.uid)
        && (list.size() < 3 || list[2].get('uid', '') == request.auth.uid);
    }

    // ---------- Konten ----------

    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'games'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.games is list
        && request.resource.data.games.size() == 0;
      // Der Name bleibt fest, nur die Liste der Spiele ändert sich
      // Der Name bleibt fest; ändern dürfen sich die Liste der Spiele und die freiwillige E-Mail
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['games', 'email', 'loginKey'])
        && request.resource.data.games is list
        && request.resource.data.games.size() <= 50
        && (!('email' in request.resource.data) || (request.resource.data.email is string
              && request.resource.data.email.size() <= 254))
        && (!('loginKey' in request.resource.data) || request.resource.data.loginKey is string);
    }

    // Vergebene Benutzernamen (nur nötig, wenn das Konto eine echte E-Mail-Adresse bekommt)
    match /names/{key} {
      allow get: if true;
      allow list, update: if false;
      allow create: if signedIn() && key.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Anmelden mit Benutzername, wenn das Konto eine echte E-Mail-Adresse hat.
    // Die ID entsteht aus Benutzername + Passwort, finden kann den Eintrag also nur, wer beides kennt.
    // email = zuletzt eingetragene Adresse, alt = bisher bestätigte (solange die neue noch nicht bestätigt ist)
    function validLogin(key) {
      let d = request.resource.data;
      return signedIn() && key.matches('^[a-f0-9]{64}$')
        && d.keys().hasOnly(['email', 'alt', 'uid'])
        && d.uid == request.auth.uid
        && d.email is string && d.email.size() <= 254
        && d.get('alt', '') is string && d.get('alt', '').size() <= 254;
    }

    match /logins/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if validLogin(key);
      allow update: if validLogin(key) && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Spiele ----------

    match /games/{g} {
      // Ansehen darf jeder, der die ID kennt. Auflisten aller Spiele darf niemand.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && g.matches('^[a-z0-9]{16,32}$')
        && request.resource.data.keys().hasOnly(['name', 'owner', 'ownerName', 'locked', 'songsEnabled', 'songsSeeded', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && validGameName(request.resource.data.name)
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 30
        && request.resource.data.locked == false
        && request.resource.data.get('songsEnabled', true) is bool
        && request.resource.data.get('songsSeeded', false) is bool
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'locked', 'songsEnabled', 'songsSeeded'])
        && validGameName(request.resource.data.name)
        && request.resource.data.locked is bool
        && request.resource.data.get('songsEnabled', true) is bool
        && request.resource.data.songsSeeded is bool;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Einladungscode: nur die Spielleitung (die Regeln selbst dürfen ihn trotzdem prüfen)
      match /private/{docId} {
        allow read, delete: if isOwner(g);
        allow create, update: if docId == 'invite' && isOwnerAfter(g)
          && request.resource.data.keys().hasOnly(['code', 'open'])
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 12
          && request.resource.data.open is bool;
      }

      // Nachweis der Einladung: wird zusammen mit dem Feld angelegt
      match /members/{uid} {
        allow read, delete: if signedIn() && (request.auth.uid == uid || isOwner(g));
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['invite', 'joinedAt'])
          && request.resource.data.joinedAt == request.time
          && validInvite(g, request.resource.data.invite)
          && existsAfter(boardPath(g, uid));
      }

      // Bingo-Felder: alle sehen alle. Jeder ändert nur die 25 Wörter seines eigenen Feldes,
      // und das nur, solange nicht gesperrt ist. Die Spielleitung vergibt das Recht für Tageswörter.
      match /boards/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'cells', 'canAddWords'])
          && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name
          && request.resource.data.canAddWords == true
          && request.resource.data.cells == ['', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '']
          // Spielleitung (beim Erstellen des Spiels) oder mit gültiger Einladung (members-Eintrag im selben Batch)
          && (isOwnerAfter(g) || existsAfter(/databases/$(database)/documents/games/$(g)/members/$(uid)));
        allow update: if signedIn() && (
          (
            request.auth.uid == uid
            && !fieldsLocked(g)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cells'])
            && request.resource.data.cells is list
            && request.resource.data.cells.size() == 25
          ) || (
            isOwner(g)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canAddWords'])
            && request.resource.data.canAddWords is bool
          )
        );
        // Selbst verlassen oder von der Spielleitung entfernt werden
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(g));
      }

      // Adventskalender: alle lesen. Spielleitung und Spieler mit Berechtigung tragen Wörter ein.
      match /days/{day} {
        allow read: if true;
        allow delete: if isOwner(g);
        allow create, update: if validDay(day)
          && (isOwner(g) || (isPlayer(g) && myBoard(g).get('canAddWords', true) == true))
          && request.resource.data.keys().hasOnly(['words', 'updatedBy', 'updatedAt'])
          && request.resource.data.words is list
          && request.resource.data.words.size() <= 12
          && request.resource.data.updatedBy is string
          && request.resource.data.updatedAt == request.time;
      }

      // Liederpool: alle lesen, Spieler ergänzen Lieder (nur wenn die Lieder eingeschaltet sind).
      // Entfernen darf, wer das Lied ergänzt hat, und die Spielleitung.
      match /songs/{songId} {
        allow read: if true;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.get('addedByUid', '') == request.auth.uid || isOwner(g));
        allow create: if (isOwnerAfter(g) || (isPlayer(g) && songsOn(g)))
          && songId.matches('^[a-z0-9-]{1,80}$')
          && request.resource.data.keys().hasOnly(['title', 'addedBy', 'addedByUid'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 60
          && request.resource.data.addedBy is string
          && request.resource.data.addedBy.size() <= 30
          && request.resource.data.addedByUid == request.auth.uid;
      }

      // Lieder eines Abends: höchstens 3. Spieler dürfen Zufallslieder austauschen und ihre
      // eigenen ausgesuchten Lieder hinzufügen oder entfernen, aber nicht die von anderen.
      function validSongDay() {
        let d = request.resource.data;
        return d.keys().hasOnly(['picked', 'random', 'updatedAt'])
          && d.picked is list
          && d.random is list
          && d.picked.size() + d.random.size() <= 3
          && d.updatedAt == request.time;
      }

      match /songDays/{day} {
        allow read: if true;
        allow delete: if isOwner(g);
        allow create: if validDay(day) && validSongDay()
          && (isOwner(g) || (isPlayer(g) && songsOn(g) && allMine(request.resource.data.picked)));
        allow update: if validDay(day) && validSongDay() && (isOwner(g) || (
          isPlayer(g) && songsOn(g)
          // entfernte und neu hinzugekommene ausgesuchte Lieder müssen alle die eigenen sein
          && allMine(resource.data.picked.removeAll(request.resource.data.picked))
          && allMine(request.resource.data.picked.removeAll(resource.data.picked))
        ));
      }
    }
  }
}
