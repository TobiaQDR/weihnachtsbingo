rules_version = '2';

// Sicherheitsregeln für das Weihnachtsbingo.
// In der Firebase-Konsole unter Firestore Database > Regeln einfügen und "Veröffentlichen".
// WICHTIG: Die UID in isAdmin() muss die deines Spielleiter-Kontos sein.
//
// Aufbau:
//   game/settings     { locked }                    Sperre der Felder
//   game/invite       { code, open }                geheimer Einladungscode (nur Spielleiter liest ihn)
//   players/{code}    { name, boardId, uid?, invite?, pinKey? } geheimer Spieler-Eintrag (nur per Code abrufbar)
//   logins/{pinKey}   { code, boardId }             Anmeldung mit Name + PIN; Schlüssel = SHA-256(Feld + PIN)
//   boards/{boardId}  { name, cells, canAddWords }  öffentliches Bingo-Feld, alle dürfen es sehen
//   members/{uid}     { code, boardId }             verknüpft einen (anonym angemeldeten) Browser mit einem Spieler
//   days/{1..24}      { words, updatedBy, updatedAt } Wörter des Adventskalenders
//   songs/{songId}    { title, addedBy }            Liederpool (ID = Titel als Kürzel, verhindert Doppelte)
//   songDays/{1..24}  { picked, random, updatedAt } Lieder eines Abends: picked = von Spielern ausgesucht
//                                                   [{ title, by }], random = zufällig aufgefüllt [title]

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'T0mHHroTerXRkcUytm1TyrNR6Sx1';
    }

    function isMember() {
      return request.auth != null && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function myBoardId() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.boardId;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Beitritt per Einladungslink: Code muss stimmen und Beitritt muss offen sein
    function validInvite(inviteCode) {
      let inv = get(/databases/$(database)/documents/game/invite).data;
      return inviteCode is string && inv.get('open', false) == true && inv.code == inviteCode;
    }

    function fieldsLocked() {
      return get(/databases/$(database)/documents/game/settings).data.get('locked', false) == true;
    }

    // Spieleinstellungen (Sperre): alle lesen, nur Spielleiter schreibt
    match /game/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Einladungscode: nur Spielleiter (die Regeln selbst dürfen ihn trotzdem prüfen)
    match /game/invite {
      allow read, write: if isAdmin();
    }

    // Geheime Spieler-Links: Wer den Code kennt, darf genau dieses Dokument lesen.
    // Auflisten (und damit alle Codes sehen) darf nur der Spielleiter.
    match /players/{code} {
      allow get: if true;
      allow list, delete: if isAdmin();
      // Der Spieler selbst darf nur seine PIN (pinKey) ändern
      allow update: if isAdmin() || (
        isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == code
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinKey'])
        && request.resource.data.pinKey is string
      );
      // Selbst beitreten: zusammen mit Feld und members-Eintrag in einem Rutsch anlegen
      allow create: if isAdmin() || (
        signedIn()
        && code.matches('^[a-z0-9-]{4,64}$')
        && request.resource.data.keys().hasOnly(['name', 'boardId', 'uid', 'invite', 'pinKey'])
        && request.resource.data.uid == request.auth.uid
        && validInvite(request.resource.data.invite)
        && getAfter(/databases/$(database)/documents/boards/$(request.resource.data.boardId)).data.name == request.resource.data.name
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == code
      );
    }

    // Öffentliche Felder: alle sehen alle. Ein Spieler darf nur die 25 Wörter
    // seines eigenen Feldes ändern, und das nur, solange nicht gesperrt ist.
    match /boards/{boardId} {
      allow read: if true;
      allow delete: if isAdmin();
      // Neues, leeres Feld beim Beitritt (der Spieler-Eintrag prüft den Einladungscode).
      // Wer neu beitritt, darf erst einmal Tageswörter eintragen.
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.keys().hasOnly(['name', 'cells', 'canAddWords'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.canAddWords == true
        && request.resource.data.cells == ['', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '', '']
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.boardId == boardId
        && getAfter(/databases/$(database)/documents/players/$(getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.code)).data.boardId == boardId
      );
      allow update: if isAdmin() || (
        isMember()
        && myBoardId() == boardId
        && !fieldsLocked()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cells'])
        && request.resource.data.cells is list
        && request.resource.data.cells.size() == 25
      );
    }

    // Ein Browser weist sich als Spieler aus, indem er den geheimen Code kennt.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'boardId'])
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[a-z0-9-]{4,64}$')
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.code)).data.boardId == request.resource.data.boardId;
    }

    // Anmeldung mit Name + PIN: Wer Feld und PIN kennt, kennt den Schlüssel und darf genau
    // dieses Dokument lesen (und erfährt so seinen Spieler-Code). Auflisten nur Spielleiter.
    // Anlegen nur für den eigenen Spieler und nur mit dem Schlüssel, der beim Spieler steht.
    match /logins/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        signedIn()
        && key.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['code', 'boardId'])
        && request.resource.data.code is string
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == request.resource.data.code
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.code)).data.pinKey == key
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.code)).data.boardId == request.resource.data.boardId
      );
      allow delete: if isAdmin() || (
        isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == resource.data.code
      );
    }

    // Adventskalender: alle lesen. Spielleiter darf alles, Spieler mit Berechtigung
    // dürfen die Wörter eines Tages eintragen und ändern.
    match /days/{day} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if day.matches('^([1-9]|1[0-9]|2[0-4])$') && (isAdmin() || (
        isMember()
        && get(/databases/$(database)/documents/boards/$(myBoardId())).data.get('canAddWords', true) == true
        && request.resource.data.keys().hasOnly(['words', 'updatedBy', 'updatedAt'])
        && request.resource.data.words is list
        && request.resource.data.words.size() <= 12
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedAt == request.time
      ));
    }

    // Liederpool: alle lesen, Spieler dürfen Lieder ergänzen, nur der Spielleiter entfernt welche.
    match /songs/{songId} {
      allow read: if true;
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isMember()
        && songId.matches('^[a-z0-9-]{1,80}$')
        && request.resource.data.keys().hasOnly(['title', 'addedBy'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.addedBy is string
        && request.resource.data.addedBy.size() <= 30
      );
    }

    // Lieder eines Abends: höchstens 3. Spieler dürfen Zufallslieder austauschen,
    // aber keine von Spielern ausgesuchten Lieder entfernen (das darf nur der Spielleiter).
    function validSongDay() {
      let d = request.resource.data;
      return d.keys().hasOnly(['picked', 'random', 'updatedAt'])
        && d.picked is list
        && d.random is list
        && d.picked.size() + d.random.size() <= 3
        && d.updatedAt == request.time;
    }

    match /songDays/{day} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if day.matches('^([1-9]|1[0-9]|2[0-4])$') && (isAdmin() || (isMember() && validSongDay()));
      allow update: if day.matches('^([1-9]|1[0-9]|2[0-4])$') && (isAdmin() || (
        isMember()
        && validSongDay()
        && request.resource.data.picked.hasAll(resource.data.picked)
      ));
    }

    // Altes Format (wird beim ersten Öffnen der Spielleiter-Seite übernommen)
    match /draws/{drawId} {
      allow read, write: if isAdmin();
    }
  }
}
